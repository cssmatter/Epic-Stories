#!/usr/bin/env python3
"""
Lyrics Video Renderer
Complete pipeline: extract lyrics -> render Remotion video with synchronized animations
"""

import os
import re
import sys
import json
import argparse
import subprocess
from pathlib import Path

# Import our extraction module
sys.path.insert(0, str(Path(__file__).parent))
from extract_lyrics import extract_lyrics_to_json


def normalize_path_for_remotion(path: Path, remotion_root: Path) -> str:
    """
    Convert a file system path to a path that Remotion/React can use.
    Returns a relative path from remotion_root to the file, or falls back to file:// URI.
    """
    path = path.resolve()

    # Try to compute relative path from remotion_root
    try:
        rel_path = os.path.relpath(path, remotion_root)
        # Convert to forward slashes (for web compatibility)
        return rel_path.replace("\\", "/")
    except ValueError:
        # On different drives on Windows, use file:// URI
        return path.as_uri()


