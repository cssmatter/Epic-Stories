# Image Generator Environment Variables (Optional)
# Copy this file to .env and uncomment options

# 🆕 LOCAL Stable Diffusion (100% FREE - No API keys!)
# Runs on your computer, no internet needed after first download
# Model: stabilityai/stable-diffusion-xl-base-1.0 (~7GB, downloaded once)
# Device: cuda (NVIDIA GPU), cpu, or mps (Mac)
SD_MODEL=stabilityai/stable-diffusion-xl-base-1.0
SD_DEVICE=cuda

# Cloudflare Worker (Already configured - internal service)
# CLOUDFLARE_AUTH_TOKEN=Bearer shivaay143$manish

# Gemini (Free 60 requests/min)
# Get key at: https://makersuite.google.com/app/apikey
# GEMINI_API_KEY=your-gemini-api-key-here

# Hugging Face (Free - Requires account)
# Get token at: https://huggingface.co/settings/tokens
# HF_TOKEN=your-huggingface-token-here

# Replicate (Free credits available)
# Get token at: https://replicate.com/account/api-tokens
# REPLICATE_API_TOKEN=your-replicate-token-here

# Choose generator: auto, stable-diffusion, gemini, huggingface, replicate, cloudflare
# Default auto tries: Local SD → Cloudflare → Gemini → HuggingFace → Replicate → Gradient
IMAGE_GENERATOR=auto
